<Window x:Class="NHMPh_music_player.Inpicture"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NHMPh_music_player"
        mc:Ignorable="d"
        Title="Inpicture" Height="220" Width="220" WindowStyle="None" Background="Black" ResizeMode="NoResize" Topmost="True">
    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="controler" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
            <ColorAnimation Storyboard.TargetName="mainGrid" Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)" To="#4C000000" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="closeButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="openmain" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="controler" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
            <ColorAnimation Storyboard.TargetName="mainGrid" Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)" To="#00000000" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="closeButton" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="openmain" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>
    <Grid x:Name="mainGrid" Background="#00000000" MouseEnter="Grid_MouseEnter" MouseLeave="Grid_MouseLeave">
        <Button x:Name="closeButton" Content="X" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0" Click="closeButton_Click" Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
        <Button x:Name="openmain" Content="[ ]" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,40,0" Click="openmainButton_Click" Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

        <Viewbox Stretch="Uniform">
            <StackPanel x:Name="controler" Orientation="Vertical" VerticalAlignment="Center" Margin="0,800,0,0" Opacity="0">
                <Grid Height="80" MouseLeftButtonDown="thumb_MouseLeftButtonDown">
                    <ProgressBar ValueChanged="songValue_ValueChanged" x:Name="songValue" Background="Gray" Height="10" Foreground="White" Margin="6,14,6,14" Maximum="255" Width="900" Value="0" />
                    <Slider x:Name="thumb" Width="900" Height="50" Value="0" Margin="6,8,6,10" Maximum="255" Grid.ColumnSpan="2" GotMouseCapture="thumb_GotMouseCapture" LostMouseCapture="thumb_LostMouseCapture">
                        <Slider.Template>
                            <ControlTemplate TargetType="Slider">
                                <Grid>
                                    <Rectangle x:Name="PART_SelectionRange" HorizontalAlignment="Left" Fill="#FF9E1616" />
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Width="50" Height="50">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Ellipse Fill="{TemplateBinding Background}" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>    
                                </Grid>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                    
                   
                    <Button ToolTip="Loop" Height="160" Width="160" Background="Transparent" BorderThickness="0" Margin="20,8,4,0" Click="loop_btn">
                        <Image x:Name="loop_img" Source="/Loop_off.png"/>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="80"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button ToolTip="Resume/Pause" Height="160" Width="160" Background="Transparent" BorderThickness="0" Margin="4,8,4,0" Click="stop_btn">
                        <Image x:Name="stopresumeimg" Source="/_Pause.png"/>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="80"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button ToolTip="Skip" Height="160" Width="160" Background="Transparent" BorderThickness="0" Margin="4,8,4,0" Click="skip_btn" >
                        <Image Source="/Next.png"/>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="80"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    
                    
                </StackPanel>
            </StackPanel>
        </Viewbox>
    </Grid>
</Window>
